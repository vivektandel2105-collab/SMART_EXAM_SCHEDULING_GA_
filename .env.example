# SmartExam Environment Configuration Template

# Server Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Settings
PROJECT_NAME="SmartExam"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / SQLite fallback for development)
# For local development with SQLite: sqlite:///./smartexam.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/smartexam_db
DATABASE_URL=sqlite:///./smartexam.db

# Security & JWT Token Config
SECRET_KEY=smartexam_super_secret_jwt_key_change_in_production_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Genetic Algorithm Default Engine Configuration
DEFAULT_POPULATION_SIZE=100
DEFAULT_MAX_GENERATIONS=500
DEFAULT_CROSSOVER_RATE=0.80
DEFAULT_MUTATION_RATE=0.10
DEFAULT_ELITE_COUNT=5
DEFAULT_TOURNAMENT_SIZE=5
